
# Required — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash-lite
# GEMINI_THINKING_BUDGET=1024
# For maximum accuracy (slower/costlier): GEMINI_MODEL=gemini-2.5-pro
# EMBED_MODEL=gemini-embedding-001
# TOP_K=5
# SUMMARY_TOP_K=12
# MAX_CHUNKS=80
# MAX_CHUNK_CHARS=1200
# MAX_OUTPUT_TOKENS=1024
# EMBED_BATCH_SIZE=8
# EMBED_BATCH_DELAY=0.5
# EMBED_REQUESTS_PER_MINUTE=12
# GEMINI_REQUESTS_PER_MINUTE=30
# GEMINI_MAX_RETRIES=5
# GEMINI_RETRY_BASE_DELAY=2
# GEMINI_RETRY_MAX_DELAY=60
# MAX_PDF_BYTES=26214400
# MAX_PDF_PAGES=120
# MAX_PAPERS_IN_MEMORY=20
